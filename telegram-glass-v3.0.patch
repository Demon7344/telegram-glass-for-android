+            if (i < 0 || i >= COLS) continue;
+            float k = 1f - Math.abs(i - c0) / (float) (span + 1);
+            colH[i] = Math.min(maxPile(), colH[i] + add * k);
+        }
+        // smooth: neighbours can't be much lower (leaves slide down the slope)
+        for (int i = 1; i < COLS; i++) colH[i] = Math.max(colH[i], colH[i - 1] - l.size);
+        for (int i = COLS - 2; i >= 0; i--) colH[i] = Math.max(colH[i], colH[i + 1] - l.size);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        if (seenVersion != enabledVersion) { seenVersion = enabledVersion; mode = getMode(); enabledCache = mode > 0; speedMul = SPEED_MUL[Math.max(0, Math.min(2, getSpeed()))]; qtyMul = QTY_MUL[Math.max(0, Math.min(2, getQty()))]; reset(); prefill = true; }
+        if (prefill && getWidth() > 0 && enabledCache) { prefill = false; doPrefill(getWidth(), getHeight()); }
+        if (paused || !isShown()) { lastFrame = 0; return; }
+        discoTarget = GlassDisco.isOn() && GlassDisco.musicPlaying();
+        final boolean leafTarget = enabledCache && !discoTarget;
+        {
+            long nn = SystemClock.elapsedRealtime();
+            float fdt = lastFrame == 0 ? 0.016f : Math.min(0.05f, (nn - lastFrame) / 1000f);
+            discoAmt = Math.max(0, Math.min(1, discoAmt + (discoTarget ? fdt : -fdt)));
+            leafAmt = Math.max(0, Math.min(1, leafAmt + (leafTarget ? fdt : -fdt)));
+        }
+        if (!discoTarget && !leafTarget && discoAmt <= 0 && leafAmt <= 0) {
+            if (!falling.isEmpty()) falling.clear();
+            lastFrame = 0;
+            postInvalidateDelayed(400); // idle: wait for music / settings
+            return;
+        }
+        final int W = getWidth(), H = getHeight();
+        if (W <= 0 || H <= 0) return;
+        final long now = SystemClock.elapsedRealtime();
+        float dt = lastFrame == 0 ? 0.016f : Math.min(0.05f, (now - lastFrame) / 1000f);
+        lastFrame = now;
+        if (cycleStart == 0) cycleStart = now;
+        final float d = getResources().getDisplayMetrics().density;
+
+        {
+            // spawn (constant stream, never stops)
+            float minH = Float.MAX_VALUE;
+            for (float h : colH) minH = Math.min(minH, h);
+            if (discoTarget || leafTarget) spawnAcc += dt * SIZES[sizeIdx()][3] * speedMul * qtyMul;
+            while (spawnAcc >= 1f) {
+                spawnAcc -= 1f;
+                if (falling.size() < (int) (SIZES[sizeIdx()][2] * 1.3f * qtyMul)) spawn(W);
+            }
+            float t = (now - cycleStart) / 1000f;
+            for (int i = falling.size() - 1; i >= 0; i--) {
+                Leaf l = falling.get(i);
+                l.sway += l.swayV * dt;
+                l.flip += l.flipV * dt;
+                l.x += (l.vx + (float) Math.sin(l.sway) * (sizeIdx() == 3 ? 34 : 24) * d) * dt;
+                l.y += (l.vy * (0.8f + 0.3f * (float) Math.abs(Math.cos(l.sway)))) * dt;
+                l.rot += (l.kind < 0 ? 25f : (l.rotV + (float) Math.cos(l.sway) * 40)) * dt;
+                if ((l.kind < 0 && discoAmt <= 0) || (l.kind >= 0 && leafAmt <= 0)) { falling.remove(i); continue; }
+                if (l.x < -l.size) l.x += W + l.size; else if (l.x > W + l.size) l.x -= W + l.size;
+                if (l.y - l.size > H) falling.remove(i); // endless fall: just leaves the screen
+            }
+        }
+        boolean clip = buildOcclusion();
+        if (clip) {
+            canvas.save();
+            if (android.os.Build.VERSION.SDK_INT >= 26) canvas.clipOutPath(occPath);
+            else canvas.clipPath(occPath, android.graphics.Region.Op.DIFFERENCE);
+        }
+        for (Leaf l : falling) {
+            float a = l.kind < 0 ? discoAmt : leafAmt;
+            if (a <= 0.003f) continue;
+            float os = l.size;
+            l.size = os * (0.55f + 0.45f * a);
+            l.alpha = a;
+            if (l.kind < 0) {
+                // slow spin, subtle twinkle
+                float tw = 0.85f + 0.15f * (float) Math.sin(now / 160.0 + l.sway * 3);
+                l.alpha = a * tw;
+            }
+            drawLeaf(canvas, l, 1f, (float) Math.cos(l.flip));
+            l.size = os;
+        }
+        if (clip) canvas.restore();
+        postInvalidateOnAnimation();
+    }
+}
