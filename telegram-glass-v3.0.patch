+package org.telegram.ui.Components.glass;
+
+import android.content.Context;
+import android.widget.Toast;
+
+import org.telegram.ui.ActionBar.AlertDialog;
+
+/** Telegram Glass v11.1: simple background picker dialog (saved immediately as bg_<uid>). */
+public final class GlassBgPicker {
+    public static void show(Context ctx, long uid, Runnable onChanged) {
+        if (ctx == null) return;
+        if (uid == 0) uid = GlassDecor.self();
+        final long u0 = uid;
+        AlertDialog.Builder m = new AlertDialog.Builder(ctx);
+        m.setTitle(u0 == GlassDecor.self() ? "Фон моего профиля" : "Фон этого профиля");
+        m.setItems(new CharSequence[]{"🎨  Цвет фона", "✨  Узор"}, (d, which) -> {
+            if (which == 0) showColors(ctx, u0, onChanged); else showPatterns(ctx, u0, onChanged);
+        });
+        m.setNegativeButton("Закрыть", null);
+        m.show();
+    }
+
+    public static void showPatterns(Context ctx, long u, Runnable onChanged) {
+        final int cur = GlassDecor.getPattern(u);
+        final String[] names = GlassDecor.PATTERN_NAMES_RU;
+        CharSequence[] items = new CharSequence[names.length];
+        for (int i = 0; i < names.length; i++) items[i] = (cur == i ? "✓  " : "      ") + names[i];
+        AlertDialog.Builder b = new AlertDialog.Builder(ctx);
+        b.setTitle("Узор");
+        b.setItems(items, (d, which) -> {
+            GlassDecor.setPattern(u, which);
+            String msg = "Узор: " + names[which];
+            if (!GlassDecor.isActive(u)) msg += " (сначала выберите цвет фона)";
+            Toast.makeText(ctx, msg, Toast.LENGTH_SHORT).show();
+            if (onChanged != null) onChanged.run();
+        });
+        b.setNegativeButton("Отмена", null);
+        b.show();
+    }
+
+    public static void showColors(Context ctx, long uid, Runnable onChanged) {
+        if (uid == 0) uid = GlassDecor.self();
+        final long u = uid;
+        final int cur = GlassDecor.getBackground(u);
+        final int n = GlassDecor.BG_NAMES_RU.length;
+        CharSequence[] items = new CharSequence[n + 1];
+        items[0] = (cur < 0 ? "✓  " : "      ") + "Стандартный";
+        for (int i = 0; i < n; i++) items[i + 1] = (cur == i ? "✓  " : "      ") + GlassDecor.BG_NAMES_RU[i];
+        AlertDialog.Builder b = new AlertDialog.Builder(ctx);
+        b.setTitle(u == GlassDecor.self() ? "Фон моего профиля" : "Фон этого профиля");
+        b.setItems(items, (d, which) -> {
+            final int idx = which - 1;
+            GlassDecor.setBackground(u, idx);
+            Toast.makeText(ctx, idx < 0 ? "Стандартный фон" : "Фон выбран: " + GlassDecor.BG_NAMES_RU[idx], Toast.LENGTH_SHORT).show();
+            if (onChanged != null) onChanged.run();
+        });
+        b.setNegativeButton("Отмена", null);
+        b.show();
+    }
+}
