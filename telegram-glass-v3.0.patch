+                final float al = 0.55f * (1f - k / 7.5f) * wave;
+                shape.setColor(shapeColor);
+                shape.setAlpha((int) (200 * al));
+                if (pattern >= 2) {
+                    drawShape(canvas, pattern, px, py, s, t, i + k);
+                    continue;
+                }
+                final int kind = (i + k) % 3;
+                if (kind == 0) { // soft dot
+                    shape.setStyle(Paint.Style.FILL);
+                    canvas.drawCircle(px, py, s * 0.22f, shape);
+                } else if (kind == 1) { // ring
+                    shape.setStyle(Paint.Style.STROKE); shape.setStrokeWidth(1.6f * dp);
+                    canvas.drawCircle(px, py, s * 0.32f, shape);
+                } else { // rotated diamond
+                    shape.setStyle(Paint.Style.FILL);
+                    canvas.save(); canvas.rotate(45 + t * 8f, px, py);
+                    r.set(px - s * 0.2f, py - s * 0.2f, px + s * 0.2f, py + s * 0.2f);
+                    canvas.drawRoundRect(r, 2 * dp, 2 * dp, shape);
+                    canvas.restore();
+                }
+            }
+        }
+        postInvalidateDelayed(33);
+    }
+
+    private static Path STAR, HEART, LEAF;
+    private final Path tmp = new Path();
+    private static void initPaths() {
+        if (STAR != null) return;
+        STAR = new Path();
+        for (int i = 0; i < 10; i++) {
+            double a = -Math.PI / 2 + i * Math.PI / 5; float r = i % 2 == 0 ? 1f : 0.42f;
+            float x = (float) (r * Math.cos(a)), y = (float) (r * Math.sin(a));
+            if (i == 0) STAR.moveTo(x, y); else STAR.lineTo(x, y);
+        }
+        STAR.close();
+        HEART = new Path();
+        HEART.moveTo(0, 0.9f);
+        HEART.cubicTo(-1.1f, 0.1f, -0.9f, -0.95f, 0f, -0.4f);
+        HEART.cubicTo(0.9f, -0.95f, 1.1f, 0.1f, 0f, 0.9f);
+        HEART.close();
+        LEAF = new Path();
+        LEAF.moveTo(0, -1f);
+        LEAF.cubicTo(0.75f, -0.5f, 0.7f, 0.5f, 0f, 1f);
+        LEAF.cubicTo(-0.7f, 0.5f, -0.75f, -0.5f, 0f, -1f);
+        LEAF.close();
+    }
+
+    private void drawShape(Canvas canvas, int p, float px, float py, float s, float t, int seed) {
+        final float dp = AndroidUtilities.density;
+        initPaths();
+        switch (p) {
+            case 2: shape.setStyle(Paint.Style.FILL); canvas.drawCircle(px, py, s * 0.24f, shape); return;
+            case 3: shape.setStyle(Paint.Style.STROKE); shape.setStrokeWidth(1.8f * dp); canvas.drawCircle(px, py, s * 0.34f, shape); return;
+            case 4: {
+                shape.setStyle(Paint.Style.FILL);
+                canvas.save(); canvas.rotate(45 + t * 8f, px, py);
+                r.set(px - s * 0.22f, py - s * 0.22f, px + s * 0.22f, py + s * 0.22f);
+                canvas.drawRoundRect(r, 2 * dp, 2 * dp, shape);
+                canvas.restore(); return;
+            }
+            case 5: case 6: case 8: {
+                shape.setStyle(Paint.Style.FILL);
+                canvas.save(); canvas.translate(px, py);
+                float rot = p == 8 ? (seed * 47 % 360) + t * 10f : p == 5 ? t * 12f : 0;
+                canvas.rotate(rot);
+                float sc = s * (p == 6 ? 0.36f : 0.4f);
+                if (p == 6) sc *= 1f + 0.08f * (float) Math.sin(t * 3 + seed);
+                canvas.scale(sc, sc);
+                canvas.drawPath(p == 5 ? STAR : p == 6 ? HEART : LEAF, shape);
+                if (p == 8) {
+                    int a = shape.getAlpha();
+                    shape.setStyle(Paint.Style.STROKE); shape.setStrokeWidth(0.08f); shape.setAlpha(a / 2);
+                    canvas.drawLine(0, -0.85f, 0, 0.95f, shape); shape.setAlpha(a);
+                }
+                canvas.restore(); return;
+            }
+            case 7: {
+                shape.setStyle(Paint.Style.STROKE); shape.setStrokeWidth(1.8f * dp); shape.setStrokeCap(Paint.Cap.ROUND);
+                float w = s * 0.5f, ph = t * 2f + seed;
+                tmp.reset();
+                for (int j = 0; j <= 12; j++) {
+                    float x = px - w + 2 * w * j / 12f;
+                    float y = py + (float) Math.sin(ph + j * Math.PI / 6) * s * 0.12f;
+                    if (j == 0) tmp.moveTo(x, y); else tmp.lineTo(x, y);
+                }
+                canvas.drawPath(tmp, shape); return;
+            }
+            case 9: {
+                shape.setStyle(Paint.Style.FILL);
+                canvas.save(); canvas.rotate((seed * 37 % 60) - 30, px, py);
+                r.set(px - s * 0.2f, py - s * 0.02f, px + s * 0.2f, py + s * 0.3f);
+                canvas.drawOval(r, shape);
+                float tr = s * 0.085f;
+                canvas.drawCircle(px - s * 0.25f, py - s * 0.08f, tr, shape);
+                canvas.drawCircle(px - s * 0.09f, py - s * 0.22f, tr, shape);
+                canvas.drawCircle(px + s * 0.09f, py - s * 0.22f, tr, shape);
+                canvas.drawCircle(px + s * 0.25f, py - s * 0.08f, tr, shape);
+                canvas.restore(); return;
+            }
+            case 10: default: {
+                shape.setStyle(Paint.Style.STROKE); shape.setStrokeWidth(1.5f * dp); shape.setStrokeCap(Paint.Cap.ROUND);
+                canvas.save(); canvas.rotate(t * 6f + seed * 13, px, py);
+                float L = s * 0.36f, b = L * 0.4f;
+                for (int j = 0; j < 3; j++) {
+                    canvas.drawLine(px - L, py, px + L, py, shape);
+                    canvas.drawLine(px + L * 0.55f, py, px + L * 0.55f + b * 0.6f, py - b * 0.6f, shape);
+                    canvas.drawLine(px + L * 0.55f, py, px + L * 0.55f + b * 0.6f, py + b * 0.6f, shape);
+                    canvas.drawLine(px - L * 0.55f, py, px - L * 0.55f - b * 0.6f, py - b * 0.6f, shape);
+                    canvas.drawLine(px - L * 0.55f, py, px - L * 0.55f - b * 0.6f, py + b * 0.6f, shape);
+                    canvas.rotate(60, px, py);
+                }
+                canvas.restore();
+            }
+        }
+    }
+}
