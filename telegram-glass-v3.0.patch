+package org.telegram.ui.Components.glass;
+
+import android.content.Context;
+import android.graphics.BlendMode;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffXfermode;
+import android.graphics.Shader;
+import android.os.Build;
+import android.os.SystemClock;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.MediaController;
+import org.telegram.messenger.MessageObject;
+
+/**
+ * Telegram Glass v13.1: "disco" while music plays. A touch-transparent overlay on top of chats and profiles
+ * recolors everything below it with smoothly cycling rainbow hues. It uses the COLOR blend mode (hue+saturation
+ * from the rainbow, brightness from the content), so text keeps its contrast. Fades in/out with playback.
+ */
+public class GlassDisco extends View {
+    private static android.content.SharedPreferences prefs() { return ApplicationLoader.applicationContext.getSharedPreferences("glass_decor", Context.MODE_PRIVATE); }
+    public static boolean isOn() { return prefs().getBoolean("disco_music", true); }
+    public static void setOn(boolean v) { prefs().edit().putBoolean("disco_music", v).apply(); }
+
+    public static boolean musicPlaying() {
+        try {
+            MediaController mc = MediaController.getInstance();
+            MessageObject m = mc.getPlayingMessageObject();
+            return m != null && m.isMusic() && !mc.isMessagePaused();
+        } catch (Throwable e) { return false; }
+    }
+
+    /** Current disco hue as a solid colour (~10 s per full cycle). */
+    public static int hueColor(float sat, float val) {
+        float t = SystemClock.elapsedRealtime() / 1000f;
+        float h = ((330f - t * 36f) % 360f + 360f) % 360f;
+        return Color.HSVToColor(new float[]{h, sat, val});
+    }
+
+    // ---- global fade level shared by overlays and glass elements ----
+    private static float sLevel;
+    private static long sLast;
+    private static boolean sTarget;
+    private static long sTargetCheck;
+    /** 0..1, smoothly follows music playback (~0.8 s). Cheap to call every frame. */
+    public static float level() {
+        long now = SystemClock.elapsedRealtime();
+        if (now - sTargetCheck > 100) { sTargetCheck = now; sTarget = isOn() && musicPlaying(); }
+        float dt = sLast == 0 ? 0 : Math.min(0.1f, (now - sLast) / 1000f);
+        sLast = now;
+        sLevel = Math.max(0, Math.min(1, sLevel + (sTarget ? dt : -dt) / 0.8f));
+        if (!sTarget && sLevel <= 0) sLast = 0;
+        return sLevel;
+    }
+
+    private static final Paint gFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint gHaze = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint gRim = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Paint gGlow = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final Matrix gM = new Matrix();
+    static {
+        gRim.setStyle(Paint.Style.STROKE);
+        gGlow.setStyle(Paint.Style.STROKE);
+        if (Build.VERSION.SDK_INT >= 29) gFill.setBlendMode(BlendMode.SCREEN);
+    }
+
+    /** Holographic "aurora" glass during music: rainbow tint + frosted haze inside, moving rainbow glowing rim. */
+    public static void drawGlass(Canvas c, android.graphics.RectF r, float radius, float alpha) {
+        float lv = level();
+        if (lv <= 0.003f || r == null || r.width() < 2 || r.height() < 2) return;
+        float a = lv * Math.max(0, Math.min(1, alpha));
+        float t = SystemClock.elapsedRealtime() / 1000f;
+        float rr = Math.max(0, Math.min(radius, Math.min(r.width(), r.height()) / 2f));
+        float d = org.telegram.messenger.AndroidUtilities.density;
+        // frosted haze
+        // v13.3: semi-opaque frosted fill so content behind glass is hidden and its text stays clear
+        boolean dark = org.telegram.ui.ActionBar.Theme.isCurrentThemeDark();
+        int base = dark ? 0xFF1A1C24 : 0xFFF4F4F8;
+        gHaze.setColor(androidx.core.graphics.ColorUtils.blendARGB(base, hueColor(0.6f, dark ? 0.35f : 1f), 0.25f));
+        gHaze.setAlpha((int) (255 * 0.82f * a));
+        c.drawRoundRect(r, rr, rr, gHaze);
+        // shifting rainbow tint
+        LinearGradient lg = new LinearGradient(r.left, r.top, r.right, r.bottom, RAINBOW, null, Shader.TileMode.MIRROR);
+        gM.reset();
+        float L = Math.max(r.width(), r.height());
+        gM.postTranslate(((t / 3f) % 2f) * L, 0);
+        lg.setLocalMatrix(gM);
+        gFill.setShader(lg);
+        gFill.setAlpha((int) (255 * 0.22f * a));
+        c.drawRoundRect(r, rr, rr, gFill);
+        // moving rainbow rim + soft glow
+        android.graphics.SweepGradient sg = new android.graphics.SweepGradient(r.centerX(), r.centerY(), RAINBOW, null);
+        gM.reset();
+        gM.postRotate((t * 90f) % 360f, r.centerX(), r.centerY());
+        sg.setLocalMatrix(gM);
+        gGlow.setShader(sg);
+        gGlow.setStrokeWidth(5 * d);
+        gGlow.setAlpha((int) (255 * 0.35f * a));
+        c.drawRoundRect(r, rr, rr, gGlow);
+        gRim.setShader(sg);
