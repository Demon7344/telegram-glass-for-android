+package org.telegram.ui.Components.glass;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+
+/**
+ * Telegram Glass: local-only profile decorations (animated backdrop + decorative gifts), stored per user id.
+ * Own profile: your choice. Other users: none by default, can be chosen per profile. Nothing is sent to the server.
+ */
+public final class GlassDecor {
+    public static final String[] BG_NAMES_RU = {"Фиолетовый", "Зелёный", "Синий", "Розовый", "Бирюзовый", "Тёмный", "Закат", "Океан"};
+    /** center (bright) / edge (dark) colors of the backdrop */
+    public static final int[][] BG_COLORS = {
+        {0xFFCC6BFA, 0xFF330B73}, {0xFF6BDB73, 0xFF08381F}, {0xFF52ADFF, 0xFF081A61},
+        {0xFFFF7ABD, 0xFF540836}, {0xFF52E6D1, 0xFF053642}, {0xFF524A7A, 0xFF05050A},
+        {0xFFFFA85C, 0xFF57123D}, {0xFF42CCF2, 0xFF12124D}};
+    public static final int[] GIFT_RES = {R.drawable.glass_gift_star, R.drawable.glass_gift_heart, R.drawable.glass_gift_crown, R.drawable.glass_gift_diamond,
+        R.drawable.glass_gift_moon, R.drawable.glass_gift_flower, R.drawable.glass_gift_clover, R.drawable.glass_gift_cat,
+        R.drawable.glass_gift_rocket, R.drawable.glass_gift_gift, R.drawable.glass_gift_bolt, R.drawable.glass_gift_note};
+    public static final int[] EMBLEM_RES = {R.drawable.glass_emblem_star, R.drawable.glass_emblem_heart, R.drawable.glass_emblem_crown, R.drawable.glass_emblem_diamond,
+        R.drawable.glass_emblem_moon, R.drawable.glass_emblem_flower, R.drawable.glass_emblem_clover, R.drawable.glass_emblem_cat,
+        R.drawable.glass_emblem_rocket, R.drawable.glass_emblem_gift, R.drawable.glass_emblem_bolt, R.drawable.glass_emblem_note};
+    public static final int[] GIFT_COLORS = {0xFFFFD34A, 0xFFFF4F7B, 0xFFFFA43A, 0xFF46E3F5, 0xFF7B6BFF, 0xFFFF5FC8,
+        0xFF4CF06A, 0xFFC56BFF, 0xFFFF6A3D, 0xFF4F9BFF, 0xFFFFF04A, 0xFF3FF0C0};
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("glass_decor", Context.MODE_PRIVATE);
+    }
+    public static long self() { return UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId(); }
+    private static boolean isSelf(long uid) { return uid == 0 || uid == self(); }
+
+    /** -1 = standard Telegram look */
+    public static int getBackground(long uid) { return prefs().getInt("bg_" + uid, isSelf(uid) ? prefs().getInt("bg", 0) : -1); }
+    public static void setBackground(long uid, int i) { prefs().edit().putInt("bg_" + uid, i).apply(); version++; }
+    public static boolean giftsEnabled(long uid) { return prefs().getBoolean("gifts_" + uid, isSelf(uid) && prefs().getBoolean("gifts", true)); }
+    public static void setGiftsEnabled(long uid, boolean v) { prefs().edit().putBoolean("gifts_" + uid, v).apply(); version++; }
+    public static int giftsMask(long uid) { return prefs().getInt("gifts_mask_" + uid, 0b1011); }
+    public static void setGiftsMask(long uid, int m) { prefs().edit().putInt("gifts_mask_" + uid, m).apply(); version++; }
+    // v11.2: pattern of the profile backdrop. 0 = classic mix (dots/rings/diamonds)
+    public static final String[] PATTERN_NAMES_RU = {"Классический", "Без узора", "Точки", "Кольца", "Ромбы", "Звёзды", "Сердечки", "Волны", "Листья", "Кошачьи лапки", "Снежинки"};
+    public static int getPattern(long uid) { return prefs().getInt("pattern_" + (uid == 0 ? self() : uid), 0); }
+    public static void setPattern(long uid, int i) { prefs().edit().putInt("pattern_" + (uid == 0 ? self() : uid), i).apply(); version++; }
+    public static boolean isActive(long uid) { int b = getBackground(uid); return b >= 0 && b < BG_COLORS.length; }
+    /** bumps on every change so views can re-read */
+    public static volatile int version;
+
+    private static final Bitmap[] giftBitmaps = new Bitmap[GIFT_RES.length];
+    private static final Bitmap[] emblemBitmaps = new Bitmap[EMBLEM_RES.length];
+    public static Bitmap gift(int i) {
+        if (giftBitmaps[i] == null) {
+            try { giftBitmaps[i] = BitmapFactory.decodeResource(ApplicationLoader.applicationContext.getResources(), GIFT_RES[i]); } catch (Throwable ignore) {}
+        }
+        return giftBitmaps[i];
+    }
+    public static Bitmap emblem(int i) {
+        if (emblemBitmaps[i] == null) {
+            try { emblemBitmaps[i] = BitmapFactory.decodeResource(ApplicationLoader.applicationContext.getResources(), EMBLEM_RES[i]); } catch (Throwable ignore) {}
+        }
+        return emblemBitmaps[i];
+    }
+    public static int[] selectedGifts(long uid, int max) {
+        int m = giftsMask(uid); int[] tmp = new int[GIFT_RES.length]; int n = 0;
+        for (int i = 0; i < GIFT_RES.length && n < max; i++) if ((m & (1 << i)) != 0) tmp[n++] = i;
+        if (n == 0) { tmp[0] = 0; tmp[1] = 1; tmp[2] = 3; n = 3; }
+        int[] r = new int[n]; System.arraycopy(tmp, 0, r, 0, n); return r;
+    }
+
+    /** ResourcesProvider wrapper: makes the profile list transparent / glassy over the backdrop with light text. */
+    public static org.telegram.ui.ActionBar.Theme.ResourcesProvider wrap(final org.telegram.ui.ActionBar.Theme.ResourcesProvider base) {
+        return new org.telegram.ui.ActionBar.Theme.ResourcesProvider() {
+            @Override
+            public int getColor(int key) {
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundGray || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundGrayShadow) return 0;
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhite) return 0x33000000;
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlackText) return 0xFFFFFFFF;
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayText || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayText2
+                    || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayText3 || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayText4) return 0xB3FFFFFF;
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlueText || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlueText2
+                    || key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlueHeader) return 0xFFD6ECFF;
+                if (key == org.telegram.ui.ActionBar.Theme.key_divider) return 0x22FFFFFF;
+                if (key == org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteGrayIcon) return 0xCCFFFFFF;
+                return base != null ? base.getColor(key) : org.telegram.ui.ActionBar.Theme.getColor(key);
+            }
+            @Override
+            public android.graphics.drawable.Drawable getDrawable(String drawableKey) { return base != null ? base.getDrawable(drawableKey) : null; }
+            @Override
+            public android.graphics.Paint getPaint(String paintKey) { return base != null ? base.getPaint(paintKey) : org.telegram.ui.ActionBar.Theme.getThemePaint(paintKey); }
+            @Override
+            public boolean isDark() { return true; }
+        };
+    }
+}
