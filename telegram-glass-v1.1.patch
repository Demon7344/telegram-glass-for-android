diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassSheetDrawable.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassSheetDrawable.java
new file mode 100644
index 0000000..58da023
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassSheetDrawable.java
@@ -0,0 +1,86 @@
+package org.telegram.ui.Components.glass;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/**
+ * Bottom sheet background for the liquid-glass mod: draws the original nine-patch
+ * (soft shadow + rounded top) and the frosted glass on top of its fill area.
+ * Falls back to the original drawable when no backdrop snapshot is available.
+ */
+public class LiquidGlassSheetDrawable extends Drawable {
+
+    private final Drawable inner;
+    public final LiquidGlassBackdrop backdrop;
+    private final Rect padding = new Rect();
+    private final RectF rect = new RectF();
+    private int surfaceColor;
+    private int alpha = 255;
+
+    public LiquidGlassSheetDrawable(Drawable inner, LiquidGlassBackdrop backdrop, int surfaceColor) {
+        this.inner = inner;
+        this.backdrop = backdrop;
+        this.surfaceColor = surfaceColor;
+        inner.getPadding(padding);
+    }
+
+    public Drawable getInner() {
+        return inner;
+    }
+
+    public void setSurfaceColor(int color) {
+        if (surfaceColor != color) {
+            surfaceColor = color;
+            invalidateSelf();
+        }
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        final Rect b = getBounds();
+        inner.setBounds(b);
+        inner.draw(canvas);
+        final Callback cb = getCallback();
+        if (cb instanceof View && backdrop.hasBitmap()) {
+            rect.set(b.left + padding.left, b.top + padding.top, b.right - padding.right, b.bottom);
+            final float r = dp(23);
+            backdrop.draw(canvas, (View) cb, rect, r, r, 0, 0, surfaceColor, alpha);
+        }
+    }
+
+    @Override
+    public boolean getPadding(@NonNull Rect padding) {
+        return inner.getPadding(padding);
+    }
+
+    @Override
+    protected void onBoundsChange(@NonNull Rect bounds) {
+        inner.setBounds(bounds);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        this.alpha = alpha;
+        inner.setAlpha(alpha);
+    }
+
+    @Override
+    public void setColorFilter(@Nullable ColorFilter colorFilter) {
+        inner.setColorFilter(colorFilter);
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
