@@ -0,0 +1,110 @@
+package org.telegram.ui.Components.glass;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.text.InputType;
+import android.text.method.LinkMovementMethod;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.LocaleController;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+
+/** Telegram Glass: dialog to enter the user's own api_id / api_hash (my.telegram.org/apps). */
+public class GlassApiDialog {
+
+    private static boolean ru() {
+        try { return LocaleController.getInstance().getCurrentLocale().getLanguage().startsWith("ru"); } catch (Throwable e) { return true; }
+    }
+
+    public static void show(Activity activity, boolean cancelable) {
+        if (activity == null) return;
+        final boolean ru = ru();
+        final SharedPreferences sp = activity.getSharedPreferences("glass_api", Context.MODE_PRIVATE);
+        LinearLayout ll = new LinearLayout(activity);
+        ll.setOrientation(LinearLayout.VERTICAL);
+        int pad = AndroidUtilities.dp(24);
+        ll.setPadding(pad, AndroidUtilities.dp(8), pad, 0);
+
+        TextView info = new TextView(activity);
+        info.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        info.setTextSize(14);
+        info.setText(ru
+            ? "Для работы Telegram Glass нужны ваши собственные api_id и api_hash.\n1. Откройте my.telegram.org/apps и войдите по номеру.\n2. Создайте приложение (любое название, платформа Android).\n3. Скопируйте App api_id и App api_hash сюда.\n\nEnglish: open my.telegram.org/apps, log in, create an app and paste its api_id and api_hash below."
+            : "Telegram Glass needs your own api_id and api_hash.\n1. Open my.telegram.org/apps and log in with your phone.\n2. Create an application (any name, platform Android).\n3. Paste App api_id and App api_hash below.");
+        ll.addView(info);
+
+        TextView link = new TextView(activity);
+        link.setText(ru ? "Открыть my.telegram.org/apps" : "Open my.telegram.org/apps");
+        link.setTextColor(Theme.getColor(Theme.key_dialogTextLink));
+        link.setTextSize(15);
+        link.setPadding(0, AndroidUtilities.dp(10), 0, AndroidUtilities.dp(6));
+        link.setOnClickListener(v -> {
+            try { activity.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse("https://my.telegram.org/apps"))); } catch (Throwable ignore) {}
+        });
+        ll.addView(link);
+
+        final EditText id = new EditText(activity);
+        id.setHint("api_id");
+        id.setInputType(InputType.TYPE_CLASS_NUMBER);
+        id.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        id.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        int cur = sp.getInt("api_id", 0);
+        if (cur > 0) id.setText(String.valueOf(cur));
+        ll.addView(id);
+
+        final EditText hash = new EditText(activity);
+        hash.setHint("api_hash");
+        hash.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        hash.setTextColor(Theme.getColor(Theme.key_dialogTextBlack));
+        hash.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint));
+        hash.setText(sp.getString("api_hash", ""));
+        ll.addView(hash);
+
+        AlertDialog.Builder b = new AlertDialog.Builder(activity);
+        b.setTitle("API ID / API Hash");
+        b.setView(ll);
+        b.setPositiveButton(ru ? "Сохранить" : "Save", (d, w) -> {
+            int newId = 0;
+            try { newId = Integer.parseInt(id.getText().toString().trim()); } catch (Throwable ignore) {}
+            String newHash = hash.getText().toString().trim().toLowerCase();
+            if (newId <= 0 || !newHash.matches("[0-9a-f]{32}")) {
+                Toast.makeText(activity, ru ? "Неверный api_id или api_hash (32 символа 0-9a-f)" : "Invalid api_id or api_hash (32 hex chars)", Toast.LENGTH_LONG).show();
+                AndroidUtilities.runOnUIThread(() -> show(activity, cancelable), 300);
+                return;
+            }
+            sp.edit().putInt("api_id", newId).putString("api_hash", newHash).commit();
+            Toast.makeText(activity, ru ? "Сохранено, перезапуск…" : "Saved, restarting…", Toast.LENGTH_SHORT).show();
+            restart(activity);
+        });
+        if (cancelable) b.setNegativeButton(ru ? "Отмена" : "Cancel", null);
+        AlertDialog dlg = b.create();
+        dlg.setCanceledOnTouchOutside(cancelable);
+        dlg.setCancelable(cancelable);
+        dlg.show();
+    }
+
+    private static void restart(Activity activity) {
+        AndroidUtilities.runOnUIThread(() -> {
+            try {
+                Intent i = activity.getPackageManager().getLaunchIntentForPackage(activity.getPackageName());
+                if (i != null) {
+                    i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+                    android.app.PendingIntent pi = android.app.PendingIntent.getActivity(activity, 7344, i, android.app.PendingIntent.FLAG_IMMUTABLE | android.app.PendingIntent.FLAG_CANCEL_CURRENT);
+                    android.app.AlarmManager am = (android.app.AlarmManager) activity.getSystemService(Context.ALARM_SERVICE);
+                    am.set(android.app.AlarmManager.RTC, System.currentTimeMillis() + 600, pi);
+                }
+            } catch (Throwable ignore) {}
+            android.os.Process.killProcess(android.os.Process.myPid());
+            System.exit(0);
+        }, 700);
+    }
+}
