diff --git a/TMessagesProj/src/main/res/raw/ios_liquid_glass_shader.agsl b/TMessagesProj/src/main/res/raw/ios_liquid_glass_shader.agsl
new file mode 100644
index 0000000..2d17842
--- /dev/null
+++ b/TMessagesProj/src/main/res/raw/ios_liquid_glass_shader.agsl
@@ -0,0 +1,86 @@
+// iOS 26-style "Liquid Glass" (liquid-glass mod).
+// Input `img` is the content behind the glass, in node coordinates.
+// - lens refraction: bevel profile derived from the signed distance field of a rounded rect,
+//   surface normal -> displaced sample coordinate (content bends/magnifies at the rim)
+// - v7: no chromatic fringe, no frost; v10.1: no white rim / border line
+uniform shader img;
+
+uniform float2 resolution;
+uniform float2 center;
+uniform float2 size;
+uniform float4 radius;
+uniform float thickness;
+uniform float refract_index;
+uniform float refract_intensity;
+uniform float4 foreground_color_premultiplied;
+uniform float chroma;
+uniform float specular;
+uniform float dark;
+uniform float tint_scale;
+
+float sdfRect(float2 p, float4 r) {
+  r.xy = (p.x > 0.0) ? r.xy : r.zw;
+  r.x  = (p.y > 0.0) ? r.x  : r.y;
+  float2 q = abs(p) - size + r.x;
+  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
+}
+
+half4 main(float2 fragCoord) {
+  float2 p = fragCoord - center;
+  float sd = sdfRect(p, radius);
+  float coverage = clamp(0.5 - sd, 0.0, 1.0);
+  if (coverage <= 0.0) {
+    return half4(0.0);
+  }
+
+  // 2D outward normal of the shape
+  float2 g = float2(
+    sdfRect(p + float2(1.0, 0.0), radius) - sdfRect(p - float2(1.0, 0.0), radius),
+    sdfRect(p + float2(0.0, 1.0), radius) - sdfRect(p - float2(0.0, 1.0), radius)
+  );
+  float gl = length(g);
+  float2 n2 = gl > 0.0001 ? g / gl : float2(0.0, 0.0);
+
+  // e: 1 at the rim, 0 deeper than `thickness` (edge band) inside. Center stays e = 0 -> clear glass.
+  float th = max(thickness, 1.0);
+  float e = 1.0 - clamp(-sd / th, 0.0, 1.0);
+  float k = refract_intensity * 1.3333;            // default intensity 0.75 -> k = 1
+
+  // strong lens refraction in the edge band: sample is pulled inward along the normal,
+  // so content near the rim is stretched/magnified and visibly bends around the corners
+  float bend = pow(e, 1.6);
+  float dispLen = th * 0.70 * k * bend;
+  float2 uv = fragCoord - n2 * dispLen;
+  // slight overall magnification (clear lens in the middle)
+  uv = center + (uv - center) * (1.0 - 0.06 * k);
+
+  // no chromatic fringe, no frost: single clean sample (liquid-glass mod v7)
+  float4 col = img.eval(uv) + float4(0.0 * chroma);
+
+  // light vibrancy
+  float l = dot(col.rgb, float3(0.299, 0.587, 0.114));
+  col.rgb = mix(float3(l), col.rgb, 1.12);
+  col.rgb = clamp(col.rgb, float3(0.0), float3(col.a));
+
+  // slight tint only (glass stays transparent): scale down the supplied surface colour
+  float4 tint = float4(foreground_color_premultiplied) * tint_scale;
+  col = tint + col * (1.0 - tint.a);
+
+  // depth: subtle darkening inside the bevel
+  col.rgb *= float(1.0 - e * e * (dark > 0.5 ? 0.16 : 0.08));
+
+  // v10.2: thin soft angle-dependent specular rim (iOS 26), ~1dp, brighter top-left & bottom-right
+  float2 L = normalize(float2(-0.7, -0.7));
+  float facing = abs(dot(n2, L));                       // both diagonal ends light up
+  float rimW = max(resolution.x, resolution.y) > 0.0 ? 2.6 : 2.6; // ~1dp at xxhdpi
+  float rim = clamp(1.0 - (-sd) / rimW, 0.0, 1.0);
+  rim = rim * rim;
+  float rimA = rim * (0.10 + 0.24 * pow(facing, 1.5)) * max(specular, 0.6);
+  col.rgb = mix(col.rgb, float3(col.a), rimA);
+  // very light inner shadow on the opposite edge band for separation
+  float sh = pow(e, 3.0) * (1.0 - facing) * 0.06;
+  col.rgb *= float(1.0 - sh);
+  col.rgb = clamp(col.rgb, float3(0.0), float3(col.a));
+
+  return half4(col * coverage);
+}
