diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/glass/GlassRelayService.java b/TMessagesProj/src/main/java/org/telegram/messenger/glass/GlassRelayService.java
new file mode 100644
index 0000000..1bb7640
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/glass/GlassRelayService.java
@@ -0,0 +1,259 @@
+package org.telegram.messenger.glass;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.service.notification.NotificationListenerService;
+import android.service.notification.StatusBarNotification;
+import android.text.TextUtils;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.DialogObject;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.ui.LaunchActivity;
+
+/**
+ * Telegram Glass v10: notification relay.
+ * The official Telegram app receives real FCM pushes; we only use its notifications as a wake-up
+ * signal so that Telegram Glass connects, pulls the update and shows its OWN normal notification.
+ * If nothing of ours appears within FALLBACK_MS, a simple copy of the official notification is posted.
+ * Event driven only: no polling, no wakelocks of our own.
+ */
+public class GlassRelayService extends NotificationListenerService {
+
+    public static final String[] OFFICIAL_PACKAGES = {"org.telegram.messenger", "org.telegram.messenger.web", "org.telegram.messenger.beta"};
+    public static final String PREF_ENABLED = "glassRelayEnabled";
+    public static final String PREF_HIDE = "glassRelayHideOfficial";
+    private static final long FALLBACK_MS = 8000;
+    private static final long WAKE_DEBOUNCE_MS = 3000;
+    private static final String FALLBACK_CHANNEL = "glass_relay_fallback";
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private long lastWake;
+    private int fallbackId = 0x6C000;
+
+    public static boolean isEnabled() {
+        return MessagesController.getGlobalNotificationsSettings().getBoolean(PREF_ENABLED, true);
+    }
+
+    public static boolean isHideEnabled() {
+        return MessagesController.getGlobalNotificationsSettings().getBoolean(PREF_HIDE, true);
+    }
+
+    public static boolean hasAccess(Context context) {
+        try {
+            String flat = Settings.Secure.getString(context.getContentResolver(), "enabled_notification_listeners");
+            if (TextUtils.isEmpty(flat)) return false;
+            ComponentName me = new ComponentName(context, GlassRelayService.class);
+            for (String s : flat.split(":")) {
+                ComponentName c = ComponentName.unflattenFromString(s);
+                if (me.equals(c)) return true;
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        return false;
+    }
+
+    /** @return label of an installed official Telegram, or null */
+    public static String findOfficialApp(Context context) {
+        PackageManager pm = context.getPackageManager();
+        for (String p : OFFICIAL_PACKAGES) {
+            try {
+                pm.getPackageInfo(p, 0);
+                return p;
+            } catch (Throwable ignore) {
+            }
+        }
+        return null;
+    }
+
+    private static boolean isOfficial(String pkg) {
+        for (String p : OFFICIAL_PACKAGES) if (p.equals(pkg)) return true;
+        return false;
+    }
+
+    @Override
+    public void onNotificationPosted(StatusBarNotification sbn) {
+        try {
+            if (sbn == null || !isOfficial(sbn.getPackageName()) || !isEnabled()) return;
+            final Notification n = sbn.getNotification();
+            if (n == null || (n.flags & Notification.FLAG_ONGOING_EVENT) != 0 || (n.flags & Notification.FLAG_FOREGROUND_SERVICE) != 0) return;
+            final boolean summary = (n.flags & Notification.FLAG_GROUP_SUMMARY) != 0;
+
+            final long wakeTime = System.currentTimeMillis();
+            requestWake();
+
+            if (isHideEnabled()) {
+                try { cancelNotification(sbn.getKey()); } catch (Throwable e) { FileLog.e(e); }
+            }
+            if (summary) return;
+
+            final Bundle extras = n.extras;
+            final CharSequence title = extras != null ? extras.getCharSequence(Notification.EXTRA_TITLE) : null;
+            CharSequence text = extras != null ? extras.getCharSequence(Notification.EXTRA_TEXT) : null;
+            if (extras != null) {
+                CharSequence big = extras.getCharSequence(Notification.EXTRA_BIG_TEXT);
+                if (!TextUtils.isEmpty(big)) text = big;
+            }
+            if (TextUtils.isEmpty(title) && TextUtils.isEmpty(text)) return;
+            long did = 0;
+            if (Build.VERSION.SDK_INT >= 26) {
+                String sid = n.getShortcutId();
+                if (sid != null && sid.startsWith("ndid_")) {
+                    try { did = Long.parseLong(sid.substring(5)); } catch (Throwable ignore) {}
+                }
+            }
+            final CharSequence fTitle = title, fText = text;
+            final long fDid = did;
+            final String key = sbn.getKey();
+            Runnable old = pendingFallbacks.remove(key);
+            if (old != null) handler.removeCallbacks(old);
+            Runnable r = new Runnable() {
+                @Override
+                public void run() {
+                    pendingFallbacks.remove(key);
+                    try {
+                        if (!ownNotificationSince(wakeTime)) postFallback(fTitle, fText, fDid, key);
+                    } catch (Throwable e) {
+                        FileLog.e(e);
+                    }
+                }
+            };
+            pendingFallbacks.put(key, r);
+            handler.postDelayed(r, FALLBACK_MS);
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    private final java.util.HashMap<String, Runnable> pendingFallbacks = new java.util.HashMap<>();
+    private boolean wakeScheduled;
+    private android.os.PowerManager.WakeLock wakeLock;
+
+    /** Wake now, or (if we just woke) coalesce into one more wake right after the throttle window. Never drops a signal. */
+    private void requestWake() {
+        long now = System.currentTimeMillis();
+        long dt = now - lastWake;
+        if (dt >= WAKE_DEBOUNCE_MS) {
+            wakeUp();
+        } else if (!wakeScheduled) {
+            wakeScheduled = true;
+            handler.postDelayed(() -> { wakeScheduled = false; wakeUp(); }, WAKE_DEBOUNCE_MS - dt + 50);
+        }
+    }
+
+    private void wakeUp() {
+        lastWake = System.currentTimeMillis();
+        try {
+            if (wakeLock == null) {
+                android.os.PowerManager pm = (android.os.PowerManager) getSystemService(POWER_SERVICE);
+                wakeLock = pm.newWakeLock(android.os.PowerManager.PARTIAL_WAKE_LOCK, "tgglass:relay");
+                wakeLock.setReferenceCounted(false);
+            }
+            wakeLock.acquire(15000); // short, auto-released
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+        try {
+            ApplicationLoader.postInitApplication();
+            for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+                if (!UserConfig.getInstance(a).isClientActivated()) continue;
+                final int account = a;
+                ConnectionsManager.onInternalPushReceived(a);
+                ConnectionsManager.getInstance(a).resumeNetworkMaybe();
+                // make sure the update is actually pulled even if the socket thinks it is up to date
+                org.telegram.messenger.AndroidUtilities.runOnUIThread(() -> {
+                    try { MessagesController.getInstance(account).getDifference(); } catch (Throwable e) { FileLog.e(e); }
+                }, 1500);
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    @Override
+    public void onListenerConnected() {
+        super.onListenerConnected();
+        try {
+            if (!isEnabled()) return;
+            StatusBarNotification[] active = getActiveNotifications();
+            if (active == null) return;
+            for (StatusBarNotification sbn : active) {
+                if (sbn != null && isOfficial(sbn.getPackageName())) onNotificationPosted(sbn);
+            }
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    @Override
+    public void onListenerDisconnected() {
+        super.onListenerDisconnected();
+        if (Build.VERSION.SDK_INT >= 24) {
+            try { requestRebind(new ComponentName(this, GlassRelayService.class)); } catch (Throwable e) { FileLog.e(e); }
+        }
+    }
+
+    /** Called from the app start so a killed/disconnected listener gets bound again. */
+    public static void ensureBound(Context context) {
+        if (Build.VERSION.SDK_INT >= 24 && isEnabled() && hasAccess(context)) {
+            try { requestRebind(new ComponentName(context, GlassRelayService.class)); } catch (Throwable e) { FileLog.e(e); }
+        }
+    }
+
+    private boolean ownNotificationSince(long time) {
+        if (Build.VERSION.SDK_INT < 23) return false;
+        NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
+        if (nm == null) return false;
+        for (StatusBarNotification s : nm.getActiveNotifications()) {
+            Notification n = s.getNotification();
+            if (n == null || (n.flags & Notification.FLAG_ONGOING_EVENT) != 0 || (n.flags & Notification.FLAG_FOREGROUND_SERVICE) != 0) continue;
+            if (s.getPostTime() >= time - 2000) return true;
+        }
+        return false;
+    }
+
+    private void postFallback(CharSequence title, CharSequence text, long did, String key) {
+        NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
+        if (nm == null) return;
+        if (Build.VERSION.SDK_INT >= 33 && checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return;
+        if (Build.VERSION.SDK_INT >= 26 && nm.getNotificationChannel(FALLBACK_CHANNEL) == null) {
+            nm.createNotificationChannel(new NotificationChannel(FALLBACK_CHANNEL, "Сообщения (через официальный Telegram)", NotificationManager.IMPORTANCE_HIGH));
+        }
+        Intent intent = new Intent(this, LaunchActivity.class);
+        intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        if (did != 0 && !DialogObject.isEncryptedDialog(did)) {
+            intent.setAction("com.tmessages.openchat" + Math.random() + Integer.MAX_VALUE);
+            if (did > 0) intent.putExtra("userId", did); else intent.putExtra("chatId", -did);
+            intent.putExtra("currentAccount", UserConfig.selectedAccount);
+        }
