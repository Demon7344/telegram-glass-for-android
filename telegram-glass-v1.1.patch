@@ -0,0 +1,37 @@
+package org.telegram.ui.Components.glass;
+
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+
+import org.telegram.messenger.AndroidUtilities;
+
+/** Telegram Glass v10.3: iOS 26-style specular rim drawn as a gradient canvas stroke. */
+public final class GlassRim {
+    private static final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private static final RectF r = new RectF();
+    static { paint.setStyle(Paint.Style.STROKE); }
+
+    public static void draw(Canvas canvas, RectF bounds, float radius, float alpha) {
+        if (bounds == null || bounds.width() < 2 || bounds.height() < 2 || alpha <= 0.01f) return;
+        final float sw = AndroidUtilities.dpf2(1.25f);
+        r.set(bounds);
+        r.inset(sw / 2f, sw / 2f);
+        final int a1 = (int) (0.50f * 255 * Math.min(1f, alpha));
+        final int a3 = (int) (0.30f * 255 * Math.min(1f, alpha));
+        final int a2 = (int) (0.04f * 255 * Math.min(1f, alpha));
+        paint.setStrokeWidth(sw);
+        paint.setShader(new LinearGradient(r.left, r.top, r.right, r.bottom,
+            new int[]{a1 << 24 | 0xFFFFFF, a2 << 24 | 0xFFFFFF, a2 << 24 | 0xFFFFFF, a3 << 24 | 0xFFFFFF},
+            new float[]{0f, 0.35f, 0.65f, 1f}, Shader.TileMode.CLAMP));
+        final float rr = Math.max(0, Math.min(radius - sw / 2f, Math.min(r.width(), r.height()) / 2f));
+        canvas.drawRoundRect(r, rr, rr, paint);
+    }
+
+    public static void draw(Canvas canvas, float l, float t, float rgt, float b, float radius, float alpha) {
+        RectF x = new RectF(l, t, rgt, b);
+        draw(canvas, x, radius, alpha);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassBackdrop.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassBackdrop.java
new file mode 100644
index 0000000..c43bb32
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/glass/LiquidGlassBackdrop.java
@@ -0,0 +1,297 @@
+package org.telegram.ui.Components.glass;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapShader;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.view.View;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.LiteMode;
+import org.telegram.messenger.SharedConfig;
+
+import java.util.ArrayList;
+import java.util.Collections;
+
+/**
+ * "Liquid glass" backdrop for floating surfaces that live in their own window
+ * (popup menus, bottom sheets, alert dialogs).
+ *
+ * Content of other windows can not be sampled from a separate window on every Android version,
+ * so on show we take a down-scaled snapshot of everything currently on screen
+ * ({@link AndroidUtilities#makeGlobalBlurBitmap}), blur it with Telegram's native stack blur
+ * and then draw the part of it that lies behind the host view, followed by:
+ *  - a translucent tint of the surface color (frosted look, readable text),
+ *  - a soft vertical highlight gradient (light falling on the top edge of the glass),
+ *  - a thin gradient rim stroke (specular edge that gives the glass its "thickness").
+ * The shadow is provided by the original nine-patch background drawn underneath.
+ *
+ * Works on every API level (pure Canvas + CPU blur). Controlled by
+ * {@link LiteMode#FLAG_GLASS_SURFACES}.
+ */
+public class LiquidGlassBackdrop {
+
+    public static final float DOWNSCALE = 8f;
+    private static final int BLUR_AMOUNT = 9;
+
+    public static boolean isEnabled() {
+        return LiteMode.isEnabled(LiteMode.FLAG_GLASS_SURFACES) && SharedConfig.getDevicePerformanceClass() >= SharedConfig.PERFORMANCE_CLASS_AVERAGE;
+    }
+
+    private Bitmap bitmap;
+    private BitmapShader shader;
+    private final Matrix matrix = new Matrix();
+    private final Paint blurPaint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+    private final Paint tintPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint highlightPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint rimPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Matrix gradientMatrix = new Matrix();
+    private LinearGradient highlightGradient, rimGradient;
+    private boolean gradientsForDark;
+    private final int[] location = new int[2];
+    private final Path path = new Path();
+    private final float[] radii = new float[8];
+    private final RectF rimRect = new RectF();
+
+    public LiquidGlassBackdrop() {
+        rimPaint.setStyle(Paint.Style.STROKE);
+    }
+
+    public boolean hasBitmap() {
+        return bitmap != null && !bitmap.isRecycled() || hwBitmap != null && !hwBitmap.isRecycled();
+    }
+
+    // ---- Android 13+: real lens glass (AGSL RuntimeShader via RenderEffect) over a PixelCopy snapshot ----
+    private static final float HW_SCALE = 2f;
+    private Bitmap hwBitmap;
+    private final int[] decorLocation = new int[2];
+    private android.graphics.RenderNode hwNode;
+    private org.telegram.ui.Components.blur3.LiquidGlassEffect hwEffect;
+    private final Paint hwBitmapPaint = new Paint(Paint.FILTER_BITMAP_FLAG);
+    private View lastHost;
+    private int captureId;
+
+    /**
+     * Snapshot the activity window behind the glass. On Android 13+ uses PixelCopy (exact GPU frame, async) and the
+     * glass shader; on older versions falls back to {@link #capture(View)} (CPU blur).
+     */
+    public void capture(View exclude, android.content.Context context) {
+        if (!isEnabled()) {
+            return;
+        }
+        if (android.os.Build.VERSION.SDK_INT >= 33 && LiteMode.isEnabled(LiteMode.FLAG_LIQUID_GLASS)) {
+            final android.app.Activity activity = AndroidUtilities.findActivity(context);
+            if (activity != null && activity.getWindow() != null) {
+                final android.view.Window window = activity.getWindow();
+                final View decor = window.getDecorView();
+                final int w = (int) (decor.getWidth() / HW_SCALE), h = (int) (decor.getHeight() / HW_SCALE);
+                if (w > 0 && h > 0) {
+                    try {
+                        final Bitmap target = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+                        final int id = ++captureId;
+                        final int[] loc = new int[2];
+                        decor.getLocationOnScreen(loc);
+                        android.view.PixelCopy.request(window, target, result -> {
+                            if (id != captureId || result != android.view.PixelCopy.SUCCESS) {
+                                target.recycle();
+                                if (result != android.view.PixelCopy.SUCCESS && id == captureId) {
+                                    capture(exclude);
+                                    if (lastHost != null) lastHost.invalidate();
+                                }
+                                return;
+                            }
+                            if (hwBitmap != null) {
+                                hwBitmap.recycle();
+                            }
+                            hwBitmap = target;
+                            decorLocation[0] = loc[0];
+                            decorLocation[1] = loc[1];
+                            if (lastHost != null) {
+                                lastHost.invalidate();
+                            }
+                        }, new android.os.Handler(android.os.Looper.getMainLooper()));
+                        return;
+                    } catch (Throwable e) {
+                        FileLog.e(e);
+                    }
+                }
+            }
+        }
+        capture(exclude);
+    }
+
+    public void setHost(View host) {
+        lastHost = host;
+    }
+
+    private boolean drawHw(Canvas canvas, View host, RectF rect, float rLT, float rRT, float rRB, float rLB, int surfaceColor, int alpha) {
+        if (android.os.Build.VERSION.SDK_INT < 33 || hwBitmap == null || hwBitmap.isRecycled() || !canvas.isHardwareAccelerated()) {
+            return false;
+        }
+        final int w = (int) Math.ceil(rect.width()), h = (int) Math.ceil(rect.height());
+        if (hwNode == null) {
+            hwNode = new android.graphics.RenderNode("liquidGlassBackdrop");
+            hwEffect = new org.telegram.ui.Components.blur3.LiquidGlassEffect(hwNode, 0);
+        }
+        host.getLocationOnScreen(location);
+        hwNode.setPosition(0, 0, w, h);
+        final android.graphics.RecordingCanvas rc = hwNode.beginRecording();
+        rc.translate(decorLocation[0] - (location[0] + rect.left), decorLocation[1] - (location[1] + rect.top));
+        rc.scale(HW_SCALE, HW_SCALE);
+        rc.drawBitmap(hwBitmap, 0, 0, hwBitmapPaint);
+        hwNode.endRecording();
+
+        final boolean dark = AndroidUtilities.computePerceivedBrightness(surfaceColor) < 0.721f;
+        final int tint = ColorUtils.setAlphaComponent(surfaceColor, (int) (255 * (dark ? 0.55f : 0.50f)));
+        final float th = Math.min(dp(22), Math.min(w, h) / 2.4f);
+        hwEffect.update(0, 0, w, h, rLT, rRT, rRB, rLB, th, 0.85f, 1.5f, tint);
+        hwNode.setAlpha(alpha / 255f);
+        canvas.save();
+        canvas.translate(rect.left, rect.top);
+        canvas.drawRenderNode(hwNode);
+        canvas.restore();
+        return true;
+    }
+
+    /**
+     * Snapshot the screen behind. {@code exclude} is the root view of the window that hosts the glass
+     * (may be null if that window is not attached yet).
+     */
+    public void capture(View exclude) {
+        if (!isEnabled() || AndroidUtilities.makingGlobalBlurBitmap) {
+            return;
+        }
+        try {
+            AndroidUtilities.makeGlobalBlurBitmap(b -> {
+                releaseCpu();
+                if (b == null) {
+                    return;
+                }
+                bitmap = b;
+                shader = new BitmapShader(bitmap, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP);
+                blurPaint.setShader(shader);
+            }, DOWNSCALE, BLUR_AMOUNT, null, exclude == null ? null : new ArrayList<>(Collections.singletonList(exclude)));
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    public void release() {
+        captureId++;
+        if (hwBitmap != null) {
+            hwBitmap.recycle();
+            hwBitmap = null;
+        }
+        if (hwNode != null) {
+            hwNode.discardDisplayList();
+        }
+        blurPaint.setShader(null);
+        shader = null;
+        if (bitmap != null) {
+            bitmap.recycle();
+            bitmap = null;
+        }
+    }
+
+    public boolean draw(Canvas canvas, View host, RectF rect, float radius, int surfaceColor, int alpha) {
+        return draw(canvas, host, rect, radius, radius, radius, radius, surfaceColor, alpha);
+    }
+
+    /**
+     * Draws the glass into {@code rect} (in {@code host}'s local coordinates).
+     * @return false if there is nothing to draw (no snapshot) and the caller should keep its opaque background
+     */
+    public boolean draw(Canvas canvas, View host, RectF rect, float rLT, float rRT, float rRB, float rLB, int surfaceColor, int alpha) {
+        if (host == null || rect.width() <= 0 || rect.height() <= 0 || alpha <= 0) {
+            return false;
+        }
+        lastHost = host;
+        if (drawHw(canvas, host, rect, rLT, rRT, rRB, rLB, surfaceColor, alpha)) {
+            return true;
+        }
+        if (bitmap == null || bitmap.isRecycled() || shader == null) {
+            return false;
+        }
+        host.getLocationOnScreen(location);
+        matrix.reset();
+        matrix.postScale(DOWNSCALE, DOWNSCALE);
+        matrix.postTranslate(-location[0], -location[1]);
+        shader.setLocalMatrix(matrix);
+
+        radii[0] = radii[1] = rLT;
+        radii[2] = radii[3] = rRT;
+        radii[4] = radii[5] = rRB;
+        radii[6] = radii[7] = rLB;
+        path.rewind();
+        path.addRoundRect(rect, radii, Path.Direction.CW);
+
+        // 1. blurred content behind
+        blurPaint.setAlpha(alpha);
+        canvas.drawPath(path, blurPaint);
+
+        // 2. frosted tint
+        final boolean dark = AndroidUtilities.computePerceivedBrightness(surfaceColor) < 0.721f;
+        final float tintOpacity = dark ? 0.70f : 0.72f;
+        tintPaint.setColor(ColorUtils.setAlphaComponent(surfaceColor, (int) (Color.alpha(surfaceColor) * tintOpacity * alpha / 255f)));
+        canvas.drawPath(path, tintPaint);
+
+        // 3. top highlight + 4. rim light
+        ensureGradients(dark);
+        gradientMatrix.reset();
+        gradientMatrix.postScale(1f, Math.max(1f, rect.height()));
+        gradientMatrix.postTranslate(0, rect.top);
+        highlightGradient.setLocalMatrix(gradientMatrix);
+        rimGradient.setLocalMatrix(gradientMatrix);
+        highlightPaint.setAlpha(alpha);
+        canvas.drawPath(path, highlightPaint);
+
+        final float stroke = Math.max(1f, dp(0.75f));
+        rimPaint.setStrokeWidth(stroke);
+        rimPaint.setAlpha(alpha);
+        rimRect.set(rect);
+        rimRect.inset(stroke / 2f, stroke / 2f);
+        for (int i = 0; i < 8; ++i) {
+            radii[i] = Math.max(0, radii[i] - stroke / 2f);
+        }
+        path.rewind();
+        path.addRoundRect(rimRect, radii, Path.Direction.CW);
+        // v10.1: no white rim stroke
+        return true;
+    }
+
+    private void ensureGradients(boolean dark) {
+        if (highlightGradient != null && gradientsForDark == dark) {
+            return;
+        }
+        gradientsForDark = dark;
+        // unit-height vertical gradients, scaled to the rect via local matrix
+        highlightGradient = new LinearGradient(0, 0, 0, 1,
+            new int[] { Color.argb(dark ? 0x1C : 0x40, 255, 255, 255), Color.argb(0, 255, 255, 255), Color.argb(dark ? 0x0A : 0x00, 0, 0, 0) },
+            new float[] { 0f, 0.45f, 1f }, Shader.TileMode.CLAMP);
+        highlightPaint.setShader(highlightGradient);
+        rimGradient = new LinearGradient(0, 0, 0, 1,
+            new int[] { Color.argb(dark ? 0x52 : 0xA0, 255, 255, 255), Color.argb(dark ? 0x14 : 0x30, 255, 255, 255), Color.argb(dark ? 0x26 : 0x1C, dark ? 255 : 0, dark ? 255 : 0, dark ? 255 : 0) },
